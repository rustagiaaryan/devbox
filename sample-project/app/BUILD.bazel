# Top-level binaries depend on shared services and infra.
filegroup(
    name = "cli",
    srcs = [
        "cli.sh",
        "//services/auth:auth_lib",
        "//services/data:data_lib",
        "//lib/utils:logging",
    ],
)

filegroup(
    name = "worker",
    srcs = [
        "worker.sh",
        "//services/data:indexer",
        "//lib/net:rpc",
    ],
)

filegroup(
    name = "integration_test",
    srcs = [
        "integration_test.sh",
        ":cli",
        ":worker",
    ],
)

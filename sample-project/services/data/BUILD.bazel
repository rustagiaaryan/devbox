# Data service has a branch that can run in parallel and then merges.
filegroup(
    name = "data_lib",
    srcs = [
        "data.sh",
        "//lib/net:http",
        "//lib/core:math",
    ],
)

filegroup(
    name = "cache_lib",
    srcs = [
        "cache.sh",
        "//lib/core:config",
    ],
)

filegroup(
    name = "indexer",
    srcs = [
        "indexer.sh",
        ":data_lib",
        ":cache_lib",
        "//lib/net:gateway",
    ],
)
